# Journey stages 1 and 2 on a phone (390 x 844 at DPR 3): the menus by finger, the
# races by keys on tools/plan.mjs rhythms; both pass; the HUD wraps within the width.
# Generated by tools/gen-plays.mjs.
# viewport 390x844@3
until 600 Tumble
frames 30
touch Play
until 300 Choose a mode
frames 10
save tc-phone-modes
touch Journey
until 300 Unlocked through
frames 10
save tc-phone-journey
touch 1. Warm-Up Walk
until 400 =GO!
frames 2
hold KeyW
repeat 9000 until Score breakdown
key Space 1
frames 0
key ShiftLeft 1
frames 1
end
release KeyW
frames 30
expect passed!
save tc-phone-results
touch Stage 2
until 400 =GO!
frames 2
hold KeyW
repeat 9000 until Score breakdown
key Space 1
frames 4
key ShiftLeft 1
frames 1
end
release KeyW
frames 30
expect passed!
