# The Quick Show on a desktop window: three rounds by keys on rhythms tools/plan.mjs
# checks against the show's own rosters, Continue show after each, then the show table.
# Generated by tools/gen-plays.mjs.
# viewport 1280x800@1
until 600 Tumble
frames 30
click Play
until 300 Choose a mode
frames 10
click Show
until 300 Survive each cut
frames 10
click Quick Show
until 400 =GO!
frames 2
hold KeyW
repeat 9000 until Score breakdown
key Space 1
frames 0
key ShiftLeft 1
frames 2
end
release KeyW
frames 30
click Continue show
until 400 =GO!
frames 2
hold KeyW
repeat 9000 until Score breakdown
key Space 1
frames 0
key ShiftLeft 1
frames 1
end
release KeyW
frames 30
click Continue show
until 400 =GO!
frames 2
hold KeyW
repeat 9000 until Score breakdown
key Space 1
frames 0
key ShiftLeft 1
frames 1
end
release KeyW
frames 30
click Continue show
until 600 Points
frames 10
save tc-show-over
