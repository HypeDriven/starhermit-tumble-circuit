# The five Learn lessons won by keys on a desktop window (W held, Jump then Dive on
# the rhythm tools/plan.mjs found for each); each results screen, then Next lesson;
# the last one unlocks Graduate. Generated by tools/gen-plays.mjs.
# viewport 1280x800@1
until 600 Tumble
frames 30
click Play
until 300 Choose a mode
frames 10
click Learn
until 300 One rule at a time
frames 10
save tc-learn-list
click 1. Move Out
until 400 =GO!
frames 2
hold KeyW
repeat 9000 until Score breakdown
key Space 1
frames 0
key ShiftLeft 1
frames 1
end
release KeyW
frames 30
expect complete!
save tc-learn-results
click Next lesson
until 400 =GO!
frames 2
hold KeyW
repeat 9000 until Score breakdown
key Space 1
frames 0
key ShiftLeft 1
frames 1
end
release KeyW
frames 30
expect complete!
click Next lesson
until 400 =GO!
frames 2
hold KeyW
repeat 9000 until Score breakdown
key Space 1
frames 0
key ShiftLeft 1
frames 2
end
release KeyW
frames 30
expect complete!
click Next lesson
until 400 =GO!
frames 2
hold KeyW
repeat 9000 until Score breakdown
key Space 1
frames 0
key ShiftLeft 1
frames 1
end
release KeyW
frames 30
expect complete!
click Next lesson
until 400 =GO!
frames 2
hold KeyW
repeat 9000 until Score breakdown
key Space 1
frames 0
key ShiftLeft 1
frames 1
end
release KeyW
frames 30
expect complete!
expect Graduate
save tc-learn-done
