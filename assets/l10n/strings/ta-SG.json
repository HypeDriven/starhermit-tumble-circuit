ிங்கிங் சுத்தியல்கள், பிஸ்டன்கள் மற்றும் பம்ப்பர்கள் உங்களை பறக்கவிடுகின்றன; நெசவு சுவர்கள் இடைவெளி இருக்கும் இடத்தில் மட்டுமே திறக்கப்படும். கன்வேயர் பெல்ட்கள் மற்றும் மின்விசிறிகள் உங்களைத் தள்ளும் — அவைகளுக்கு எதிராகச் சாய்கின்றன. ஒரு வெற்றிக்குப் பிறகு நீங்கள் சுருக்கமாக ப்ளாஷ் செய்கிறீர்கள்: ஃபிளாஷின் போது எதுவும் உங்களை மீண்டும் தட்ட முடியாது.","fairPlay":"நியாயமான விளையாட்டு","fairText":"ஒவ்வொரு பாடமும் விதைக்கப்பட்டுள்ளது மற்றும் ஒவ்வொரு சுற்றும் ஒரு உறுதியான மறுபதிவை பதிவு செய்கிறது, முடிவுகள் திரையில் சரிபார்க்கப்பட்டது. புறநிலை முன்னேற்றம், குறைவான தவறான செயல்கள், பின்னர் கழிந்த நேரம் ஆகியவற்றில் உறவுகள் உடைகின்றன.","you":"நீங்கள்","guestLine":"விருந்தினர் பயிற்சி — இந்தச் சாதனத்தில் முன்னேற்றம் இருக்கும்","syncSynced":"முன்னேற்றம் ஒத்திசைக்கப்பட்டது","syncSaving":"சேமிக்கிறது…","syncError":"ஒத்திசைவு நிலுவையில் உள்ளது — மீண்டும் முயற்சிக்கும்","syncOffline":"ஆஃப்லைன் — உள்ளூர் சேமிப்பு","playingAs":"{name} · {status} ஆக விளையாடுகிறது","playerN":"வீரர் {id}","rsnInactive":"செயலில் இல்லை","rsnStunned":"திகைத்தார்","rsnAirborne":"வான்வழி","rsnCooldown":"டைவ் கூலிங் டவுன்","rsnJump":"ஜம்ப் கிடைக்கவில்லை","rsnDive":"டைவ் கிடைக்கவில்லை","capInvalid":"அனுமதிக்கப்படவில்லை","capGo":"செல்!","capDive":"டைவ்","capBoing":"போயிங்","capKnock":"தட்டப்பட்டது!","capFall":"வீழ்ச்சி","capRespawn":"மீண்டும் சோதனைச் சாவடியில்","capCheckpoint":"சரிபார்ப்பு புள்ளி","capFinish":"முடிந்தது!","capOut":"வெளியேற்றப்பட்டார்","capChampion":"சாம்பியன்!","capAchievement":"சாதனை திறக்கப்பட்டது","stages.j01":"வார்ம்-அப் வாக்","stages.j02":"ஹாப்ஸ்கோட்ச் உயரங்கள்","stages.j03":"சுழல் சந்து","stages.j04":"டிராம்போலைன் டிரெயில்","stages.j05":"குறுகிய நரம்புகள்","stages.j06":"ஸ்வீப்பர் ஸ்வீப்","stages.j07":"கிளவுட் கேன்யன்","stages.j08":"குமுலஸ் கிரவுன்","stages.j09":"கிராஸ்விண்ட் கிராசிங்","stages.j10":"ஊசல் ஊர்வலம்","stages.j11":"ஹெட்விண்ட் ஹசில்","stages.j12":"சுத்தியல் வீழ்ச்சி","stages.j13":"பெல்ட்வே","stages.j14":"ஸ்விங் ஷிப்ட்","stages.j15":"டஸ்க் டேஷ்","stages.j16":"டான் டொமினியன்","st